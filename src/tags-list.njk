---
layout: base.njk
title: 所有标签
permalink: /tags/
---

<div class="tags-page">
  <header class="tags-header">
    <h1>所有标签</h1>
    <p>浏览按主题分类的文章</p>
  </header>

  <div class="tags-cloud">
    {% for tag in collections.tagList %}
      {% set tagUrl %}/tags/{{ tag }}/{% endset %}
      <a href="{{ tagUrl }}" class="tag-item">
        <span class="tag-name">#{{ tag }}</span>
        <span class="tag-count">{{ collections[tag].length }}</span>
      </a>
    {% endfor %}
  </div>

  <div class="tags-navigation">
    <a href="/" class="btn btn-primary">返回首页</a>
  </div>
</div>

<style>
  .tags-header {
    text-align: center;
    margin-bottom: 50px;
  }
  
  .tags-header h1 {
    margin-bottom: 10px;
    color: var(--secondary-color);
  }
  
  .tags-header p {
    color: var(--dark-gray);
  }
  
  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    justify-content: center;
    margin-bottom: 50px;
  }
  
  .tag-item {
    display: flex;
    align-items: center;
    padding: 10px 15px;
    background-color: var(--light-gray);
    border-radius: 30px;
    text-decoration: none;
    color: var(--secondary-color);
    font-weight: 500;
    transition: all 0.3s ease;
  }
  
  .tag-item:hover {
    background-color: var(--primary-color);
    color: #fff;
    transform: translateY(-3px);
    text-decoration: none;
  }
  
  .tag-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background-color: var(--secondary-color);
    color: #fff;
    border-radius: 50%;
    font-size: 0.8rem;
    margin-left: 8px;
  }
  
  .tag-item:hover .tag-count {
    background-color: rgba(255, 255, 255, 0.3);
  }
  
  .tags-navigation {
    text-align: center;
    margin-top: 30px;
  }
</style>

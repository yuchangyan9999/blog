---
layout: base.njk
title: 文章归档
permalink: /archive/
---

<h1>文章归档</h1>

{% set postslist = collections.post %}
{% set postslistCounter = postslist | length %}

{% if postslistCounter > 0 %}
  {# Group posts by year #}
  {% set currentYear = "" %}
  {% for post in postslist | reverse %}
    {% set postYear = post.date.getFullYear() %}
    
    {% if postYear != currentYear %}
      {% if not loop.first %}</ul>{% endif %}
      <h2 class="archive-year">{{ postYear }}</h2>
      <ul class="archive-list">
      {% set currentYear = postYear %}
    {% endif %}
    
    <li class="archive-item">
      <span class="archive-date">{{ post.date.getMonth() + 1 }}月{{ post.date.getDate() }}日</span>
      <a href="{{ post.url }}">{{ post.data.title }}</a>
    </li>
    
    {% if loop.last %}</ul>{% endif %}
  {% endfor %}
{% else %}
  <p>暂无文章</p>
{% endif %}

---
layout: base.njk
---

<article class="post">
  <header class="post-header">
    <h1 class="post-title">{{ title }}</h1>
    <div class="post-meta">
      <time datetime="{{ page.date | dateToISO }}">{{ page.date | readableDate }}</time>
      {% if tags %}
      <span class="post-tags">
        {% for tag in tags %}
          {% if tag != "post" %}
          <a href="/tags/{{ tag }}/" class="tag">#{{ tag }}</a>
          {% endif %}
        {% endfor %}
      </span>
      {% endif %}
    </div>
  </header>

  <div class="post-content">
    {{ content | safe }}
  </div>
  
  {% include "comments.njk" %}
</article>

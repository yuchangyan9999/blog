<!DOCTYPE html>
<html lang="zh">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} - {% endif %}个人博客</title>
  <link rel="stylesheet" href="/css/style.css">
  <meta name="description" content="{% if description %}{{ description }}{% else %}我的个人博客网站{% endif %}">
</head>
<body>
  <header>
    <div class="container">
      <h1 class="site-title"><a href="/">个人博客</a></h1>
      <nav>
        <ul>
          <li><a href="/">首页</a></li>
          <li><a href="/archive/">文章归档</a></li>
          <li><a href="/tags/">标签</a></li>
          <li><a href="/search/">搜索</a></li>
          <li><a href="/about/">关于我</a></li>
        </ul>
      </nav>
      <div class="theme-switch-wrapper">
        <label class="theme-switch" for="checkbox">
          <input type="checkbox" id="checkbox" />
          <div class="slider round"></div>
        </label>
        <span class="theme-mode-text">夜间模式</span>
      </div>
    </div>
  </header>

  <main class="container">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-section">
          <h3 class="footer-heading">关于博客</h3>
          <p>这是一个分享思考、知识与经验的个人博客。欢迎浏览文章并与我交流。</p>
        </div>
        
        <div class="footer-section">
          <h3 class="footer-heading">导航</h3>
          <ul class="footer-links">
            <li><a href="/">首页</a></li>
            <li><a href="/about/">关于我</a></li>
            <li><a href="/archive/">文章归档</a></li>
          </ul>
        </div>
        
        <div class="footer-section">
          <h3 class="footer-heading">联系方式</h3>
          <ul class="footer-links">
            <li><a href="mailto:your.email@example.com">发送邮件</a></li>
            <li><a href="#">微博</a></li>
            <li><a href="#">知乎</a></li>
            <li><a href="#">GitHub</a></li>
          </ul>
        </div>
      </div>
      
      <div class="footer-bottom">
        <p>&copy; {{ page.date.getFullYear() }} 个人博客. 保留所有权利.</p>
        <p class="footer-credit">由 <a href="https://www.11ty.dev/" target="_blank" rel="noopener noreferrer">Eleventy</a> 强力驱动</p>
      </div>
    </div>
  </footer>
  <script src="/js/theme-switcher.js"></script>
</body>
</html>
